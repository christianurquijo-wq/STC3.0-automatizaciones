# Copia este archivo a .env (o configura estas mismas variables como Secrets
# en Streamlit Community Cloud / donde despliegues la app) y NUNCA subas el
# .env real a GitHub — agrégalo a .gitignore.

# API Key de Gemini — gratis, sin tarjeta, en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cuenta de servicio de Google Cloud — usa UNA de las dos opciones:
# Opción A) ruta a un archivo .json en disco (no lo subas a GitHub):
GOOGLE_SERVICE_ACCOUNT_FILE=/ruta/a/tu/service-account.json
# Opción B) el contenido del .json pegado directo (útil como Streamlit Secret):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# ID del Google Sheet donde se escriben "Resumen por participante",
# "Hallazgos" y "Consumo" (el mismo que hoy usas con el menú de Apps Script).
# Se saca de la URL: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
REPORT_SPREADSHEET_ID=
